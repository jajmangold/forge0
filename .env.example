# Gitea bootstrap (replace development values)
GITEA_ADMIN_USER=agent
GITEA_ADMIN_PASS=change-me
GITEA_ADMIN_EMAIL=agent@localhost
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001/gitea/
GITEA_PUBLIC_URL=http://localhost:3001/gitea/
GITEA_LOCAL_ROOT_URL=http://localhost:3000/
GITEA_AUTO_LOGIN=false

# Portal authentication (setup.sh provisions the OAuth client and session secret)
FORGE0_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
FORGE0_ALLOWED_USERS=your-username

# LLM project chat
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
LLM_PLANNER_MODEL=mimo-v2.5-pro
LLM_WORKER_MODEL=mimo-v2.5
LLM_CRITIC_MODEL=mimo-v2.5
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3

# Self-extension (setup.sh generates the two tokens when omitted)
FORGE0_SELF_REPO=agent/forge0
FORGE0_DOGFOOD_LABEL=agent:ready
FORGE0_CODER_MODEL=planner
FORGE0_OPERATOR_TOKEN=
FORGE0_WEBHOOK_SECRET=
FORGE0_MAX_CHANGED_FILES=5
FORGE0_MAX_FILE_BYTES=128000
FORGE0_MAX_DIFF_LINES=500
FORGE0_MAX_KERNEL_DIFF_LINES=2000
FORGE0_RUN_TOKEN_BUDGET=100000
FORGE0_MAX_CRITIC_DIFF_CHARS=160000
# Critic-guided repair: max repair passes after critic rejection (default 1, hard max 2).
FORGE0_MAX_CRITIC_REPAIRS=1
# Verification-guided repair: disabled (0) or one pass after a fixed check fails (1).
FORGE0_MAX_VERIFICATION_REPAIRS=1
# Bound unattended self-extension workers; excess durable runs remain queued.
FORGE0_MAX_CONCURRENT_RUNS=1
# Create one bounded ready issue when a sanitized failure fingerprint repeats.
FORGE0_AUTO_DISCOVERY_ENABLED=false
FORGE0_DISCOVERY_MIN_OCCURRENCES=2
FORGE0_DISCOVERY_MAX_OPEN_ISSUES=2
# Diagnostic only: retain disposable clones after runs for operator inspection.
FORGE0_KEEP_WORKSPACES=false

# Service secrets
SEARXNG_SECRET_KEY=change-me
WANDB_PASSWORD=change-me
